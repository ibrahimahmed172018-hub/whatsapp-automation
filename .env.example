# ==============================================================================
# إعدادات بوت واتساب لدليفري طنطا (WhatsApp Cloud API - Meta)
# ==============================================================================

# منفذ خادم Express المحلي
PORT=3000

# ==============================================================================
# إعدادات Meta WhatsApp Cloud API الرسمية
# ==============================================================================
# رمز التحقق السري للـ Webhook (اختر أي كلمة سر قوية من اختيارك واكتب نفسها في لوحة Meta)
META_VERIFY_TOKEN=tanta_delivery_secret_token_2026

# توكن الوصول الدائم (Permanent Access Token) المستخرج من System User في Meta Business Manager
META_ACCESS_TOKEN=EAAG...

# معرف رقم الهاتف (Phone Number ID) من صفحة WhatsApp > API Setup
META_PHONE_NUMBER_ID=10xxxxxxxxxxxx

# معرف حساب واتساب للأعمال (WhatsApp Business Account ID / WABA ID)
META_WABA_ID=10xxxxxxxxxxxx

# إصدار Meta Graph API (افتراضياً v21.0)
META_GRAPH_API_VERSION=v21.0

# ==============================================================================
# إعدادات النظام والبوت لخدمة دليفري طنطا
# ==============================================================================
# رقم هاتف الأدمن لاستقبال تنبيهات الأوردرات الجديدة والدعم
ADMIN_PHONE=201000000000

# معرف جروب واتساب للمناديب والأدمن
DRIVERS_GROUP_JID=120363000000000000@g.us

# مفتاح Google Gemini API لفهم العامية وتلخيص الطلبات
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# إعدادات قاعدة بيانات Supabase (PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# مسار قاعدة بيانات SQLite المحلية كنسخة احتياطية
DB_PATH=delivery.db

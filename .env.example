# ==============================================================================
# إعدادات بوت واتساب لدليفري طنطا (Environment Variables Template)
# انسخ هذا الملف باسم .env وضع القيم الخاصة بك قبل التشغيل
# ==============================================================================

# منفذ خادم الويب Express
PORT=3000

# اسم مجلد حفظ جلسة واتساب
SESSION_DIR=auth_info

# رقم الهاتف للربط المباشر بكود الاقتران (اختياري، اتركه فارغاً إذا كنت ستستخدم مسح QR Code)
# الصيغة الدولية بدون أصفار أو علامة زائد: مثال 2010xxxxxxxx
BOT_PHONE_NUMBER=

# مسار قاعدة بيانات SQLite المحلية (تعمل كنسخة احتياطية سريعة)
DB_PATH=delivery.db

# رقم هاتف الأدمن لاستقبال إشعارات طلبات الدعم البشري والطلبات العاجلة
ADMIN_PHONE=201000000000

# معرف جروب واتساب للمناديب والأدمن (ينتهي بـ @g.us)
# لمعرفة المعرف: أضف البوت للجروب واكتب .id أو افتح http://localhost:3000/groups
DRIVERS_GROUP_JID=120363000000000000@g.us

# مفتاح Google Gemini API لفهم العامية وتلخيص الطلبات
# يمكنك استخراجه مجاناً من: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# إعدادات قاعدة بيانات Supabase السحابية (PostgreSQL)
# احصل عليها من لوحة تحكم مشروعك في Supabase -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
